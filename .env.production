# ========================================================================
# CMFlow — Configuration Production Vercel (.env.production)
# SaaS Multi-Tenant pour Community Managers & Agences Digitales
# ========================================================================

# ------------------------------------------------------------------------
# A. URL & SÉCURITÉ DE L'APPLICATION
# ------------------------------------------------------------------------
# Domaine officiel en production
NEXT_PUBLIC_APP_URL=https://cmflow.sn

# Clé secrète d'autorisation pour le Worker Cron Job (/api/cron/publish)
# À renseigner également dans le header de déclenchement Vercel Cron
CRON_SECRET=cmflow_cron_secret_production_key_99482

# ------------------------------------------------------------------------
# B. FIREBASE CLIENT SDK (Frontend & Écrans Utilisateurs)
# ------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD3Bje7pVeHPCP41pF9PLgnXlBxXBok7Fc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cmflow-dc0d6.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cmflow-dc0d6
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cmflow-dc0d6.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=133931483094
NEXT_PUBLIC_FIREBASE_APP_ID=1:133931483094:web:e2678150c3b8155f06ae77
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-Z93LLXE0QK

# ------------------------------------------------------------------------
# C. FIREBASE ADMIN SDK (Serveur Next.js API Routes & Webhooks)
# ------------------------------------------------------------------------
FIREBASE_PROJECT_ID=cmflow-dc0d6
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cmflow-dc0d6.iam.gserviceaccount.com
# La clé privée doit être collée en entier avec les \n ou sous format PEM
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------
# D. META GRAPH API (Instagram Professionnel & Pages Facebook)
# ------------------------------------------------------------------------
# Meta App ID créée sur https://developers.facebook.com
META_CLIENT_ID=4528780004104334
META_APP_ID=4528780004104334
META_CLIENT_SECRET=your_meta_app_secret_here

# ------------------------------------------------------------------------
# E. WAVE CHECKOUT API (Passerelle Mobile Money Sénégal & Côte d'Ivoire)
# ------------------------------------------------------------------------
# Clé secrète d'API Wave Business (format: wave_sn_prod_sec_...)
WAVE_API_KEY=wave_sn_prod_sec_your_wave_api_key_here

# Secret du webhook Wave pour la vérification de la signature HMAC-SHA256
WAVE_WEBHOOK_SECRET=wave_whsec_your_webhook_secret_here
WAVE_BUSINESS_ID=cmflow_wave_business

# ------------------------------------------------------------------------
# F. ORANGE MONEY WEB PAYMENT API (Orange Developer Sénégal / UEMOA)
# ------------------------------------------------------------------------
# Clés OAuth2 générées sur https://developer.orange.com
OM_CLIENT_ID=your_orange_developer_client_id
OM_CLIENT_SECRET=your_orange_developer_client_secret
OM_MERCHANT_KEY=your_orange_money_merchant_key
OM_ENV=prod

# ------------------------------------------------------------------------
# G. PASSERELLE WHATSAPP CLOUD API (Meta for Developers)
# ------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
