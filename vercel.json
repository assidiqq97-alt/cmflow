{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "regions": ["cdg1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss: https://*.firebaseio.com https://*.googleapis.com https://*.firebasestorage.app https://*.cloudfunctions.net https://api.wave.com https://api.orange.com https://graph.facebook.com https://open-api.tiktok.com https://api.linkedin.com https://www.linkedin.com; img-src 'self' https: data: blob: https://*.googleusercontent.com https://*.firebasestorage.app https://images.unsplash.com https://*.fbcdn.net https://*.cdninstagram.com https://*.licdn.com https://media.licdn.com; media-src 'self' https: data: blob: https://*.firebasestorage.app; frame-src 'self' https://*.firebaseapp.com https://pay.wave.com https://webpayment.orange-money.com https://www.facebook.com https://www.linkedin.com;"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/channels",
      "destination": "/channels.html"
    },
    {
      "source": "/settings/channels",
      "destination": "/channels.html"
    },
    {
      "source": "/dashboard/channels",
      "destination": "/channels.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/v/:token",
      "destination": "/client-review.html"
    },
    {
      "source": "/approve/:token",
      "destination": "/client-review.html"
    },
    {
      "source": "/register",
      "destination": "/register.html"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/onboarding",
      "destination": "/onboarding.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/planning",
      "destination": "/planning.html"
    },
    {
      "source": "/clients",
      "destination": "/clients.html"
    },
    {
      "source": "/media",
      "destination": "/media.html"
    },
    {
      "source": "/validation",
      "destination": "/validation.html"
    },
    {
      "source": "/inbox",
      "destination": "/inbox.html"
    },
    {
      "source": "/startpage",
      "destination": "/startpage.html"
    },
    {
      "source": "/analytics",
      "destination": "/analytics.html"
    },
    {
      "source": "/billing",
      "destination": "/billing.html"
    },
    {
      "source": "/settings",
      "destination": "/settings.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
